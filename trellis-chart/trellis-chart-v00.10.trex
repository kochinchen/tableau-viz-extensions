<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.billchen.trellischart" extension-version="0.10.0">
    <default-locale>en_US</default-locale>
    <name>Trellis Chart</name>
    <description>Small multiples (trellis) chart: one mini chart per dimension member, laid out on a grid with a chosen number of columns.</description>
    <author name="Bill Chen" email="ilovechenag49@gmail.com" organization="Aviation BI" website="https://github.com/kochinchen/tableau-viz-extensions"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://kochinchen.github.io/tableau-viz-extensions/trellis-chart/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==</icon>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="panel">
      <display-name>A Panel</display-name>
      <role-spec><role-type>discrete-dimension</role-type></role-spec>
      <fields max-count="2"/>
      <encoding-icon token="letter-a"/>
      <tooltip resource-id="tip-panel">A Panel: drop 1 or 2 dimensions. Each member becomes one small chart; with 2, the first one acts as the group.</tooltip>
    </encoding>
    <encoding id="x">
      <display-name>B X axis</display-name>
      <fields max-count="1"/>
      <encoding-icon token="letter-b"/>
      <tooltip resource-id="tip-x">B X axis: drop a date (continuous month or year works best) or one dimension. It becomes the horizontal axis of every small chart.</tooltip>
    </encoding>
    <encoding id="value">
      <display-name>C Value</display-name>
      <data-spec><data-type>numeric</data-type></data-spec>
      <fields max-count="2"/>
      <encoding-icon token="letter-c"/>
      <tooltip resource-id="tip-value">C Value (required): drop 1 or 2 measures. The first is the primary axis, e.g. SUM(Sales); the second is the secondary axis, e.g. profit ratio. Pick mark types, shared or separate axis and number formats under Format Extension.</tooltip>
    </encoding>
    <encoding id="color">
      <display-name>D Color</display-name>
      <fields max-count="1"/>
      <encoding-icon token="letter-d"/>
      <tooltip resource-id="tip-color">D Color (optional): a measure shades the bars by value (e.g. YoY %, deeper colour means a bigger drop); a dimension stacks the bars by member.</tooltip>
    </encoding>
  </worksheet-extension>
</manifest>
